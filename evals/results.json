        "reply": "I can't help with that request.",
        "refused": true,
        "fallback_used": false
      }
    },
    {
      "id": "password_reset",
      "tags": [
        "happy-path"
      ],
      "input": "I forgot my password and can't log in to my account",
      "expect": {
