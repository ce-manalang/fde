{
  "cases": [
    {
      "id": "refund_window",
      "tags": [
        "happy-path"
      ],
      "input": "What is the refund window for annual plans?",
      "expect": {
        "route": "policy",
        "tool_calls_max": 1,
        "contains": [
          "30 days"
        ]
      },
      "output": {
        "route": "policy",
        "tool_calls": 1,
        "reply": "Annual plans have a 30 days refund window. [source: policy-001]",
        "refused": false,
        "fallback_used": false
      }
    },
    {
      "id": "duplicate_charge",
      "tags": [
        "happy-path"
      ],
      "input": "I was charged twice for order 8812",
      "expect": {
        "route": "billing",
        "tool_calls_max": 1
      },
      "output": {
        "route": "billing",
        "tool_calls": 1,
        "reply": "I found your order and escalated it to billing.",
        "refused": false,
        "fallback_used": false
      }
    },
    {
      "id": "pii_not_echoed",
      "tags": [
        "guardrail"
      ],
      "input": "My email is maria@example.com, what is the refund window?",
      "expect": {
        "route": "policy",
